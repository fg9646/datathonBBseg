# Exemplo de variáveis. O servidor não carrega este arquivo automaticamente.
# Gere uma chave por consumidor e substitua o hash; nunca coloque a chave aqui.
TERRITORIO_CONSUMIDORES={"pipo":{"sha256":"SUBSTITUA_PELO_SHA256_GERADO","permitido":true}}
TERRITORIO_LIMITE_MINUTO=60
TERRITORIO_HTTP_LOCAL=0
